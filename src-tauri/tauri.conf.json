{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "压缩器",
  "version": "0.1.0",
  "identifier": "com.example.compress",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "压缩器",
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "轻量多格式压缩工具",
    "longDescription": "本地离线的多格式批量压缩工具，支持多档位质量调节。"
  }
}
